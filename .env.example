# ==== Discord (obrigatório) ====
DISCORD_TOKEN=
GUILD_ID=

# ==== Modo de desenvolvimento ====
# Quando true: Steam não inicia, FastAPI não sobe, callback OpenID não é
# registrado, login Steam fica desabilitado — só o bot Discord inicia.
# Mude para false em produção (com as variáveis Steam abaixo preenchidas)
# para ligar o sistema Steam por completo.
DEV_MODE=true

# ==== Steam (opcional — só necessário com DEV_MODE=false) ====
STEAM_API_KEY=
STEAM_OPENID_REALM=
STEAM_OPENID_RETURN_URL=

# ==== Servidor web interno (callback Steam OpenID) ====
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ==== Banco de dados ====
DATABASE_URL=sqlite+aiosqlite:///./dayz_store.db

# ==== Ambiente ====
LOG_LEVEL=INFO
